# Project-specific ignores for week01_llm-gateway.
#
# Division of labor:
# - Repo-root .gitignore owns generic Python, venv, tool cache, OS and IDE ignores.
# - This file owns service-local configuration, secrets and runtime data.

# Local gateway configuration. Keep only gateway.example.yaml in Git.
/gateway.yaml

# Local environment files and secrets.
/.env
/.env.*
!/.env.example

# SQLite databases, stream checkpoints and local runtime data.
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Local logs.
/logs/
*.log

# Local Python tool caches and bytecode, mirrored here so the project is portable on its own.
/.venv/
__pycache__/
*.py[cod]
/.pytest_cache/
/.ruff_cache/

# Test coverage output.
/.coverage
/.coverage.*
/htmlcov/

# Packaging artifacts.
/build/
/dist/
/*.egg-info/

# macOS and editor/IDE local files.
.DS_Store
**/.DS_Store
/.idea/
/.vscode/
